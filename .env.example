# ==============================================================================
# 🎙️ تنظیمات اتصال به هوش مصنوعی هرمز (Hormouz AI) یا ارائه‌دهنده‌های سازگار با OpenAI
# ==============================================================================
API_BASE_URL=https://api.hormouz.net/v1
HORMOUZ_API_KEY=

# مدل انتخابی شما برای ترجمه زیرنویس
TRANSLATION_MODEL=OpenAI: GPT-6 Luna

# مدل انتخابی شما برای تولید صدای دوبله فارسی
TTS_MODEL=google/gemini-3.8-flash-lite-tts

# ==============================================================================
# اتصال اختیاری مستقیم به Google Gemini API
# ==============================================================================
GEMINI_API_KEY=
PORT=3000
